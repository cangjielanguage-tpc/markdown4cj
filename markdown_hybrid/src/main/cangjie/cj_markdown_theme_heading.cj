            case 2 => heading2TextLetterSpacing = spacing
            case 3 => heading3TextLetterSpacing = spacing
            case 4 => heading4TextLetterSpacing = spacing
            case 5 => heading5TextLetterSpacing = spacing
            case 6 => heading6TextLetterSpacing = spacing
            case _ => ()
        }
    }

    /**
     * 设置H1和H2标题的下划线高度为统一值
     *
     * @param height 下划线高度
     */
    public func setUnderlineHeightForAllHeading(height: Float64): Unit {
        heading1UnderlineHeight = height
        heading2UnderlineHeight = height
    }

    /**
