        heading6MarginTop = margin
        heading6MarginRight = margin
        heading6MarginBottom = margin
        heading6MarginLeft = margin
    }

    /**
     * 设置指定等级标题的4个外边距为统一值
     *
     * @param level 标题等级
     * @param margin 外边距
     */
    public func setAllMarginForDesignateHeading(level: Int64, margin: Float64): Unit {
        setMarginForDesignateHeading(level, top: margin, right: margin, bottom: margin, left: margin)
    }

    /**
     * 设置指定等级标题的每个外边距
     *
     * @param level 标题等级
     * @param top-上外边距 命名参数
     * @param right-右外边距 命名参数
     * @param bottom-下外边距 命名参数
     * @param left-左外边距 命名参数
     */
    public func setMarginForDesignateHeading(level: Int64, top!: Float64, right!: Float64, bottom!: Float64, left!: Float64): Unit {
        match (level) {
            case 1 =>
                heading1MarginTop = top
                heading1MarginRight = right
                heading1MarginBottom = bottom
                heading1MarginLeft = left
            case 2 =>
                heading2MarginTop = top
                heading2MarginRight = right
                heading2MarginBottom = bottom
                heading2MarginLeft = left
            case 3 =>
                heading3MarginTop = top
                heading3MarginRight = right
                heading3MarginBottom = bottom
                heading3MarginLeft = left
            case 4 =>
                heading4MarginTop = top
                heading4MarginRight = right
                heading4MarginBottom = bottom
                heading4MarginLeft = left
            case 5 =>
                heading5MarginTop = top
                heading5MarginRight = right
                heading5MarginBottom = bottom
                heading5MarginLeft = left
            case 6 =>
                heading6MarginTop = top
                heading6MarginRight = right
                heading6MarginBottom = bottom
                heading6MarginLeft = left
            case _ => ()
        }
    }

