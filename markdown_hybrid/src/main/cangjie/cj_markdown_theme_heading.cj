        heading3TextLineHeight = lineHeight
        heading4TextLineHeight = lineHeight
        heading5TextLineHeight = lineHeight
        heading6TextLineHeight = lineHeight
    }

    /**
     * 设置指定等级标题的文本行高
     *
     * @param level 标题等级
     * @param lineHeight 文本行高
     */
    public func setTextLineHeightForDesignateHeading(level: Int64, lineHeight: Float64): Unit {
        match (level) {
            case 1 => heading1TextLineHeight = lineHeight
            case 2 => heading2TextLineHeight = lineHeight
            case 3 => heading3TextLineHeight = lineHeight
            case 4 => heading4TextLineHeight = lineHeight
            case 5 => heading5TextLineHeight = lineHeight
            case 6 => heading6TextLineHeight = lineHeight
            case _ => ()
        }
    }

    /**
     * 设置所有标题的文本字符间距为统一值
     *
     * @param spacing 文本字符间距
     */
    public func setTextLetterSpacingForAllHeading(spacing: Float64): Unit {
        heading1TextLetterSpacing = spacing
        heading2TextLetterSpacing = spacing
        heading3TextLetterSpacing = spacing
        heading4TextLetterSpacing = spacing
        heading5TextLetterSpacing = spacing
        heading6TextLetterSpacing = spacing
    }

    /**
