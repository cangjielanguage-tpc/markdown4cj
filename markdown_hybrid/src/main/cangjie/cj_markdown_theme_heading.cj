    /**
     * 设置所有标题的背景颜色为统一值
     *
     * @param color 背景颜色
     */
    public func setBackgroundColorForAllHeading(color: UInt32): Unit {
        let convertedColor = transColorForTrasparent(color)
        heading1BackgroundColor = convertedColor
        heading2BackgroundColor = convertedColor
        heading3BackgroundColor = convertedColor
        heading4BackgroundColor = convertedColor
        heading5BackgroundColor = convertedColor
        heading6BackgroundColor = convertedColor
    }

    /**
     * 设置指定等级标题的背景颜色
     *
     * @param level 标题等级
     * @param color 背景颜色
     */
    public func setBackgroundColorForDesignateHeading(level: Int64, color: UInt32): Unit {
        let convertedColor = transColorForTrasparent(color)
        match (level) {
            case 1 => heading1BackgroundColor = convertedColor
            case 2 => heading2BackgroundColor = convertedColor
            case 3 => heading3BackgroundColor = convertedColor
            case 4 => heading4BackgroundColor = convertedColor
            case 5 => heading5BackgroundColor = convertedColor
            case 6 => heading6BackgroundColor = convertedColor
            case _ => ()
        }
    }

    /**
     * 设置所有标题的4个外边距为统一值
     *
     * @param margin 外边距
     */
    public func setAllMarginForAllHeading(margin: Float64): Unit {
        heading1MarginTop = margin
        heading1MarginRight = margin
        heading1MarginBottom = margin
        heading1MarginLeft = margin
        heading2MarginTop = margin
        heading2MarginRight = margin
        heading2MarginBottom = margin
        heading2MarginLeft = margin
        heading3MarginTop = margin
