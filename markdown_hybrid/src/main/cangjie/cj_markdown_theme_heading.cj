    public func setUnderlineHeightForDesignateHeading(level: Int64, height: Float64): Unit {
        match (level) {
            case 1 => heading1UnderlineHeight = height
            case 2 => heading2UnderlineHeight = height
            case _ => ()
        }
    }

    /**
     * 设置H1和H2标题的下划线颜色为统一值
     *
     * @param color 下划线颜色
     */
    public func setUnderlineColorForAllHeading(color: UInt32): Unit {
        let convertedColor = transColorForTrasparent(color)
        heading1UnderlineColor = convertedColor
        heading2UnderlineColor = convertedColor
    }

    /**
     * 设置指定等级标题的下划线颜色（仅H1和H2）
     *
     * @param level 标题等级
     * @param color 下划线颜色
