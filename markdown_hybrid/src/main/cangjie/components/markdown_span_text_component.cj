package markdown_hybrid.components

import ohos.state_macro_manage.*

/**
 * Span控件
 *
 * 使用 @Observed + @Publish 实现样式实时变化
 * 参考 MyApplication/markdown_list_component.cj 模式：
 *   .fontColor(textColor(markdownConfiguration.markdownTheme.globalTheme.fontColor))
 * 在 @Builder 修饰链内直接访问 @Publish 叶子属性（spanMarkdownConfiguration.markdownTheme.xxx.yyy），
 * 建立响应式依赖，修改主题任意叶子属性后 UI 自动更新。
 * 辅助函数只接收原始值（如 ?String、Float64、Color），不再持有 MarkdownTheme 引用。
 *
 * @param spanMarkdownConfiguration markdown配置
 * @param nodeView NodeView
 * @param spanTocListOnClick TOC点击事件
 * @param spanFootnoteCallback 脚注点击事件
 */
@Builder
func markdownSpanComponent(
    spanMarkdownConfiguration: MarkdownConfiguration,
    nodeView: NodeView,
    spanTocListOnClick: ?(Int64) -> Unit,
    spanFootnoteCallback: (String) -> Unit,
    isTableFirst: Bool
) {
    if (nodeView.isSubNode || nodeView.isSupNode) {
        // 上标或者下标
        Span(nodeView.nodeText)
            .fontFamily(spanFontFamily(
                nodeView,
                spanMarkdownConfiguration.markdownTheme.subTheme.subTextFontFamily,
                spanMarkdownConfiguration.markdownTheme.supTheme.supTextFontFamily,
                spanMarkdownConfiguration.markdownTheme.inlineCodeTheme.inlineCodeTextFontFamily,
                spanMarkdownConfiguration.markdownTheme.boldTheme.boldTextFontFamily,
                spanMarkdownConfiguration.markdownTheme.italicTheme.italicTextFontFamily,
                spanMarkdownConfiguration.markdownTheme.strikethroughTheme.strikethroughTextFontFamily,
                spanMarkdownConfiguration.markdownTheme.highlightTheme.highlightTextFontFamily,
                spanMarkdownConfiguration.markdownTheme.htmlUnderlineTheme.htmlUnderlineTextFontFamily,
                spanMarkdownConfiguration.markdownTheme.linkTheme.linkTextFontFamily,
                spanMarkdownConfiguration.markdownTheme.footnoteRefTheme.footnoteRefTextFontFamily,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading1TextFontFamily,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading2TextFontFamily,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading3TextFontFamily,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading4TextFontFamily,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading5TextFontFamily,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading6TextFontFamily,
                spanMarkdownConfiguration.markdownTheme.tableTheme.tableTitleTextFontFamily,
                spanMarkdownConfiguration.markdownTheme.tableTheme.tableContentTextFontFamily,
                spanMarkdownConfiguration.markdownTheme.paragraphTheme.paragraphTextFontFamily))
            .fontSize(spanFontSize(
                nodeView,
                spanMarkdownConfiguration.markdownTheme.subTheme.subTextFontSize,
                spanMarkdownConfiguration.markdownTheme.supTheme.supTextFontSize,
                spanMarkdownConfiguration.markdownTheme.inlineCodeTheme.inlineCodeTextFontSize,
                spanMarkdownConfiguration.markdownTheme.boldTheme.boldTextFontSize,
                spanMarkdownConfiguration.markdownTheme.italicTheme.italicTextFontSize,
                spanMarkdownConfiguration.markdownTheme.strikethroughTheme.strikethroughTextFontSize,
                spanMarkdownConfiguration.markdownTheme.highlightTheme.highlightTextFontSize,
                spanMarkdownConfiguration.markdownTheme.htmlUnderlineTheme.htmlUnderlineTextFontSize,
                spanMarkdownConfiguration.markdownTheme.linkTheme.linkTextFontSize,
                spanMarkdownConfiguration.markdownTheme.footnoteRefTheme.footnoteRefTextFontSize,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading1TextFontSize,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading2TextFontSize,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading3TextFontSize,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading4TextFontSize,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading5TextFontSize,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading6TextFontSize,
                spanMarkdownConfiguration.markdownTheme.tableTheme.tableTitleTextFontSize,
                spanMarkdownConfiguration.markdownTheme.tableTheme.tableContentTextFontSize,
                spanMarkdownConfiguration.markdownTheme.paragraphTheme.paragraphTextFontSize))
            .fontWeight(spanFontWeight(
                nodeView,
                isTableFirst,
                spanMarkdownConfiguration.markdownTheme.subTheme.subTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.supTheme.supTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.inlineCodeTheme.inlineCodeTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.boldTheme.boldTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.italicTheme.italicTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.strikethroughTheme.strikethroughTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.highlightTheme.highlightTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.htmlUnderlineTheme.htmlUnderlineTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.linkTheme.linkTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.footnoteRefTheme.footnoteRefTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading1TextFontWeight,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading2TextFontWeight,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading3TextFontWeight,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading4TextFontWeight,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading5TextFontWeight,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading6TextFontWeight,
                spanMarkdownConfiguration.markdownTheme.tableTheme.tableTitleTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.tableTheme.tableContentTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.definitionListTheme.definitionListTermTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.paragraphTheme.paragraphTextFontWeight))
            .fontStyle(spanFontStyle(
                nodeView,
                spanMarkdownConfiguration.markdownTheme.subTheme.subTextFontStyle,
                spanMarkdownConfiguration.markdownTheme.supTheme.supTextFontStyle,
                spanMarkdownConfiguration.markdownTheme.inlineCodeTheme.inlineCodeTextFontStyle,
                spanMarkdownConfiguration.markdownTheme.boldTheme.boldTextFontStyle,
                spanMarkdownConfiguration.markdownTheme.strikethroughTheme.strikethroughTextFontStyle,
                spanMarkdownConfiguration.markdownTheme.highlightTheme.highlightTextFontStyle,
                spanMarkdownConfiguration.markdownTheme.htmlUnderlineTheme.htmlUnderlineTextFontStyle,
                spanMarkdownConfiguration.markdownTheme.linkTheme.linkTextFontStyle,
                spanMarkdownConfiguration.markdownTheme.footnoteRefTheme.footnoteRefTextFontStyle,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading1TextFontStyle,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading2TextFontStyle,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading3TextFontStyle,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading4TextFontStyle,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading5TextFontStyle,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading6TextFontStyle,
                spanMarkdownConfiguration.markdownTheme.tableTheme.tableTitleTextFontStyle,
                spanMarkdownConfiguration.markdownTheme.tableTheme.tableContentTextFontStyle,
                spanMarkdownConfiguration.markdownTheme.definitionListTheme.definitionListTermTextFontStyle,
                spanMarkdownConfiguration.markdownTheme.paragraphTheme.paragraphTextFontStyle))
            .fontColor(spanFontColor(
                nodeView,
                spanMarkdownConfiguration.markdownTheme.subTheme.subTextFontColor,
                spanMarkdownConfiguration.markdownTheme.supTheme.supTextFontColor,
                spanMarkdownConfiguration.markdownTheme.inlineCodeTheme.inlineCodeTextFontColor,
                spanMarkdownConfiguration.markdownTheme.boldTheme.boldTextFontColor,
                spanMarkdownConfiguration.markdownTheme.italicTheme.italicTextFontColor,
                spanMarkdownConfiguration.markdownTheme.strikethroughTheme.strikethroughTextFontColor,
                spanMarkdownConfiguration.markdownTheme.highlightTheme.highlightTextFontColor,
                spanMarkdownConfiguration.markdownTheme.htmlUnderlineTheme.htmlUnderlineTextFontColor,
                spanMarkdownConfiguration.markdownTheme.linkTheme.linkTextFontColor,
                spanMarkdownConfiguration.markdownTheme.footnoteRefTheme.footnoteRefTextFontColor,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading1TextFontColor,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading2TextFontColor,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading3TextFontColor,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading4TextFontColor,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading5TextFontColor,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading6TextFontColor,
                spanMarkdownConfiguration.markdownTheme.tableTheme.tableTitleTextFontColor,
                spanMarkdownConfiguration.markdownTheme.tableTheme.tableContentTextFontColor,
                spanMarkdownConfiguration.markdownTheme.paragraphTheme.paragraphTextFontColor))
            .letterSpacing(spanLetterSpacing(
