                spanMarkdownConfiguration.markdownTheme.inlineCodeTheme.inlineCodeTextBackgroundRadiusTopRight,
                spanMarkdownConfiguration.markdownTheme.inlineCodeTheme.inlineCodeTextBackgroundRadiusBottomLeft,
                spanMarkdownConfiguration.markdownTheme.inlineCodeTheme.inlineCodeTextBackgroundRadiusBottomRight,
                spanMarkdownConfiguration.markdownTheme.highlightTheme.highlightTextBackgroundColor,
                spanMarkdownConfiguration.markdownTheme.highlightTheme.highlightTextBackgroundRadiusTopLeft,
                spanMarkdownConfiguration.markdownTheme.highlightTheme.highlightTextBackgroundRadiusTopRight,
                spanMarkdownConfiguration.markdownTheme.highlightTheme.highlightTextBackgroundRadiusBottomLeft,
                spanMarkdownConfiguration.markdownTheme.highlightTheme.highlightTextBackgroundRadiusBottomRight,
                spanMarkdownConfiguration.markdownTheme.linkTheme.linkTextBackgroundColor,
                spanMarkdownConfiguration.markdownTheme.linkTheme.linkTextBackgroundRadiusTopLeft,
                spanMarkdownConfiguration.markdownTheme.linkTheme.linkTextBackgroundRadiusTopRight,
                spanMarkdownConfiguration.markdownTheme.linkTheme.linkTextBackgroundRadiusBottomLeft,
                spanMarkdownConfiguration.markdownTheme.linkTheme.linkTextBackgroundRadiusBottomRight,
                spanMarkdownConfiguration.markdownTheme.footnoteRefTheme.footnoteRefTextBackgroundColor,
                spanMarkdownConfiguration.markdownTheme.footnoteRefTheme.footnoteRefTextBackgroundRadiusTopLeft,
                spanMarkdownConfiguration.markdownTheme.footnoteRefTheme.footnoteRefTextBackgroundRadiusTopRight,
