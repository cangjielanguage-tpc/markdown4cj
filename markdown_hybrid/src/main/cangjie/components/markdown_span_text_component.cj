                spanMarkdownConfiguration.markdownTheme.subTheme.subTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.supTheme.supTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.inlineCodeTheme.inlineCodeTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.boldTheme.boldTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.italicTheme.italicTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.strikethroughTheme.strikethroughTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.highlightTheme.highlightTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.htmlUnderlineTheme.htmlUnderlineTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.linkTheme.linkTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.footnoteRefTheme.footnoteRefTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading1TextFontWeight,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading2TextFontWeight,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading3TextFontWeight,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading4TextFontWeight,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading5TextFontWeight,
                spanMarkdownConfiguration.markdownTheme.headingTheme.heading6TextFontWeight,
                spanMarkdownConfiguration.markdownTheme.tableTheme.tableTitleTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.tableTheme.tableContentTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.definitionListTheme.definitionListTermTextFontWeight,
                spanMarkdownConfiguration.markdownTheme.paragraphTheme.paragraphTextFontWeight))
            .fontStyle(spanFontStyle(
                nodeView,
                spanMarkdownConfiguration.markdownTheme.subTheme.subTextFontStyle,
                spanMarkdownConfiguration.markdownTheme.supTheme.supTextFontStyle,
                spanMarkdownConfiguration.markdownTheme.inlineCodeTheme.inlineCodeTextFontStyle,
                spanMarkdownConfiguration.markdownTheme.boldTheme.boldTextFontStyle,
                spanMarkdownConfiguration.markdownTheme.strikethroughTheme.strikethroughTextFontStyle,
