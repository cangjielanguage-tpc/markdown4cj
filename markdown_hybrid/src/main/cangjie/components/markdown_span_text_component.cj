                spanMarkdownConfiguration.markdownTheme.subTheme.subTextLetterSpacing,
                spanMarkdownConfiguration.markdownTheme.supTheme.supTextLetterSpacing,
                spanMarkdownConfiguration.markdownTheme.inlineCodeTheme.inlineCodeTextLetterSpacing,
                spanMarkdownConfiguration.markdownTheme.boldTheme.boldTextLetterSpacing,
                spanMarkdownConfiguration.markdownTheme.italicTheme.italicTextLetterSpacing,
