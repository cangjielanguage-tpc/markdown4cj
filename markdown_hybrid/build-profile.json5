{
  "apiType": "stageMode",
  "buildOption": {
    "cangjieOptions": {
      "path": "./cjpm.toml",
      "abiFilters": [
        "arm64-v8a",
        "x86_64"
      ],
      "flattenLibs": true,
      "strictCheckDependencies": false
    },
    "nativeLib": {
      "filter": {
        "pickFirsts": [
          "**/libcodeformat.so",
          "**/libcommonmark4cj.so",
          "**/libcommonmark4cj.commonmark.so",
          "**/libcommonmark4cj.strikethrough.so",
          "**/libcommonmark4cj.table.so",
          "**/libformula.so",
          "**/liblatex.so",
          "**/libmarkdown.so",
          "**/libmarkdown.components.so",
          "**/libmarkdown.components.theme.so",
          "**/libmarkdown.core.so",
          "**/libmarkdown.plugin.so",
          "**/libmarkdown.plugin.emoji.so",
          // markdown_parser（cjpm git依赖本地编译产物）与 har 内置同名库冲突（00306049）
          "**/libmarkdown_parser.so",
          "**/libmarkdown_parser.core.so",
          "**/libmarkdown_parser.plugin.so",
          "**/libmarkdown_parser.plugin.emoji.so",
          // stdx 动态库（随 har 内置）与本地构建产物冲突（00306049）
          "**/libstdx.encoding.base64.so",
          "**/libstdx.encoding.json.so",
          "**/libstdx.encoding.url.so",
          "**/libstdx.serialization.serialization.so",
          "**/libtext_to_img.so",
          "**/libmarkdown.texttoimg4cj.so",
          "**/libprism4cj.so",
          "**/libprism4cj.prism.so",
          "**/libprism4cj.languages.so",
          // Cangjie 运行时/互操作库：markdown_hybrid 本地构建产物与 ohpm 包
          // （@cangjie-tpc/markdown、@cangjie-tpc/formula）内置的同名库冲突（00306049）
          "**/lib*_diff.z.so",
          "**/libcj_*",
          "**/libcangjie-std-*.so",
          "**/libutf16string.z.so",
          "**/libboundscheck.so",
          "**/libpcre2-8.so.0"
        ]
      }
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          },
          "consumerFiles": [
            "./consumer-rules.txt"
          ]
        }
      }
    }
  ],
  "targets": [
    {
      "name": "default"
    },
    {
      "name": "ohosTest"
    }
  ]
}