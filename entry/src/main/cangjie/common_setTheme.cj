package ohos_app_cangjie_entry

import ohos.ark_interop_helper.StageContext
import ohos.hilog.Hilog
import markdown.components.MarkdownTheme


public func setParamsTheme(theme: MarkdownTheme): MarkdownTheme {
    let globalTheme = GlobalTheme()
    globalTheme.setIsMarkdownParserSync(true)
        .setEnableParseThrottle(true)
        .setParseThrottleMs(500)
        .setIsOnCopy(false)
        .setGlobalMargin(16.0)
        .setBlockSpacing(20)
        .setIsLineBreak(true)
        .setOpenGestureSwipe(true)
        .setBackgroundColor(Color.GREY)
        .setParagraphHeadingAnimationEnabled(true)
        .setParagraphHeadingAnimationDuration(600)
    theme.setGlobalTheme(globalTheme)

    let paragraphTheme = ParagraphTheme()
    paragraphTheme.setParagraphBackgroundColor(Color.GREY)
        .setParagraphMargin(12.0)
        .setParagraphPadding(6.0)
        .setParagraphTextFontColor(Color.BLACK)
        .setParagraphTextFontSize(18.0)
        .setParagraphTextFontStyle(FontStyle.Italic)
        .setParagraphTextFontWeight(FontWeight.W700)
//        .setParagraphTextFontFamily("Hei")
        .setParagraphTextLineHeight(30.0)
        .setParagraphTextLetterSpacing(2.0)
        .setParagraphBeforeSelectedBackgroundColor(Color.BLUE)
        .setParagraphSelectedBackgroundColor(Color.BLUE)
    theme.setParagraphTheme(paragraphTheme)

    let headingTheme = HeadingTheme()
    headingTheme.setBackgroundColorForAllHeading(Color.YELLOW)
        .setMarginForAllHeadingEachLevel(10.0)
        .setPaddingForAllHeadingEachLevel(5.0)
        .setTextFontColorForAllHeading(Color.BLUE)
        .setTextFontSizeForAllHeading(24.0)
        .setTextFontStyleForAllHeading(FontStyle.Italic)
        .setTextFontWeightForAllHeading(FontWeight.W800)
//        .setTextFontFamilyForAllHeading("Hei")
        .setTextLineHeightForAllHeading(36.0)
        .setTextLetterSpacingForAllHeading(3.0)
        .setUnderlineHeightForAllHeading(2.0)
        .setUnderlineColorForAllHeading(Color.BLUE)
        .setUnderlineSpacingForAllHeading(4.0)
    theme.setHeadingTheme(headingTheme)

    let tableTheme = TableTheme()
    tableTheme.setTableTitleBackgroundColor(Color.BLUE)
        .setTableContentOddRowBackgroundColor(Color.GREEN)
        .setTableContentEvenRowBackgroundColor(Color.YELLOW)
        .setTableMargin(8.0)
        .setTablePadding(4.0)
        .setTableCellPadding(8.0)
        .setTableBorderStyle(BorderStyle.Dashed)
        .setTableBorderWidth(2.0)
        .setTableBorderColor(Color.GREEN)
        .setTableRadius(10.0)
        .setTableScrollBarState(BarState.On)
        .setTableScrollBarColor(Color.RED)
        .setTableMinCellWidth(80.0)
        .setTableMaxCellWidth(400.0)
        .setTableFirstColumnIsBold(true)
        .setTableTitleTextFontColor(Color.BLUE)
        .setTableTitleTextFontSize(16.0)
        .setTableTitleTextFontStyle(FontStyle.Italic)
        .setTableTitleTextFontWeight(FontWeight.W700)
//        .setTableTitleTextFontFamily("Hei")
        .setTableTitleTextLineHeight(28.0)
        .setTableTitleTextLetterSpacing(1.5)
        .setTableContentTextFontColor(Color.GREEN)
        .setTableContentTextFontSize(15.0)
        .setTableContentTextFontStyle(FontStyle.Italic)
        .setTableContentTextFontWeight(FontWeight.W500)
//        .setTableContentTextFontFamily("Hei")
        .setTableContentTextLineHeight(26.0)
        .setTableContentTextLetterSpacing(1.0)
        .setTableStickyHeader(true)
        .setTableHeadIsShow(true)
        .setTableHeadTitleText("Table Header")
        .setTableHeadTitleTextMarginLeft(6.0)
    theme.setTableTheme(tableTheme)

    let dividerTheme = DividerTheme()
    dividerTheme.setDividerMargin(10.0)
        .setDividerPadding(5.0)
        .setDividerColor(Color.RED)
        .setDividerStrokeWidth(3.0)
        .setDividerStyle(LineCapStyle.Round)
    theme.setDividerTheme(dividerTheme)

    let blockQuoteTheme = BlockQuoteTheme()
    blockQuoteTheme.setBlockQuoteBackgroundColor(Color.BLUE)
        .setBlockQuoteMargin(12.0)
        .setBlockQuotePadding(10.0)
        .setBlockQuoteRadius(6.0)
        .setBlockQuoteLeftBorderWidth(4.0)
        .setBlockQuoteLeftBorderColor(Color.BLUE)
        .setBlockQuoteChildSpacing(4)
    theme.setBlockQuoteTheme(blockQuoteTheme)

    let orderedListTheme = OrderedListTheme()
    orderedListTheme.setOrderedListBackgroundColor(Color.YELLOW)
        .setOrderedListMargin(10.0)
        .setOrderedListPadding(6.0)
        .setOrderedListChildSpacing(4)
        .setOrderedListChildChildSpacing(2)
        .setOrderedListMarkerSpacing(12.0)
        .setOrderedListMarkerTextFontColor(Color.PINK)
        .setOrderedListMarkerTextFontSize(16.0)
        .setOrderedListMarkerTextFontStyle(FontStyle.Italic)
        .setOrderedListMarkerTextFontWeight(FontWeight.W700)
//        .setOrderedListMarkerTextFontFamily("Hei")
        .setOrderedListMarkerTextLineHeight(26.0)
    theme.setOrderedListTheme(orderedListTheme)

    let bulletListTheme = BulletListTheme()
    bulletListTheme.setBulletListBackgroundColor(Color.PINK)
        .setBulletListMargin(10.0)
        .setBulletListPadding(6.0)
        .setBulletListChildSpacing(4)
        .setBulletListChildChildSpacing(2)
        .setBulletListBulletSpacing(12.0)
        .setBulletListBulletIsCircle(true)
        .setBulletListBulletTextFontColor(Color.RED)
        .setBulletListBulletTextFontSize(6.0)
        .setBulletListBulletTextFontStyle(FontStyle.Italic)
        .setBulletListBulletTextFontWeight(FontWeight.W700)
//        .setBulletListBulletTextFontFamily("Hei")
        .setBulletListBulletTextLineHeight(22.0)
        .setBulletListCheckboxSpacing(10.0)
        .setBulletListCheckboxWidth(20.0)
        .setBulletListCheckboxHeight(20.0)
        .setBulletListCheckboxSelectedColor(Color.BLUE)
        .setBulletListCheckboxShape(CheckBoxShape.CIRCLE)
    theme.setBulletListTheme(bulletListTheme)

    let definitionListTheme = DefinitionListTheme()
    definitionListTheme.setDefinitionListBackgroundColor(Color.YELLOW)
        .setDefinitionListMargin(8.0)
        .setDefinitionListPadding(4.0)
        .setDefinitionListTermToDescriptionSpacing(12.0)
        .setDefinitionListTermTextFontWeight(FontWeight.W800)
        .setDefinitionListTermTextFontStyle(FontStyle.Normal)
        .setDefinitionListDescriptionItemSpacing(12.0)
        .setDefinitionListDescriptionIndent(16.0)
    theme.setDefinitionListTheme(definitionListTheme)

    let codeBlockTheme = CodeBlockTheme()
    codeBlockTheme.setCodeBlockIsCodeFormat(true)
        .setCodeBlockIsDark(true)
        .setCodeBlockUseTab(true)
        .setCodeBlockIndentWidth(2)
        .setCodeBlockParserSync(true)
        .setCodeBlockBackgroundColor(Color.BLACK)
        .setCodeBlockMargin(6.0)
        .setCodeBlockPadding(10.0)
        .setCodeBlockBorderStyle(BorderStyle.Dotted)
        .setCodeBlockBorderWidth(1.0)
        .setCodeBlockBorderColor(Color.BLACK)
        .setCodeBlockRadius(12.0)
        .setCodeBlockTitleLayoutMarginBottom(4.0)
        .setCodeBlockTypeTextMarginLeft(12.0)
        .setCodeBlockTypeText("custom")
        .setCodeBlockTypeTextFontColor(Color.RED)
        .setCodeBlockTypeTextFontSize(12.0)
        .setCodeBlockTypeTextFontStyle(FontStyle.Italic)
        .setCodeBlockTypeTextFontWeight(FontWeight.W600)
//        .setCodeBlockTypeTextFontFamily("Hei")
        .setCodeBlockTypeTextLineHeight(18.0)
        .setCodeBlockCopyFullScreenSpacing(8.0)
        .setCodeBlockCopyButtonIsShow(false)
        .setCodeBlockCopyTextIsShow(false)
        .setCodeBlockCopyIconWidth(30.0)
        .setCodeBlockCopyIconHeight(30.0)
        .setCodeBlockCopyIconTextSpacing(8.0)
        .setCodeBlockCopyText("COPY")
        .setCodeBlockCopyTextFontColor(Color.WHITE)
        .setCodeBlockCopyTextFontSize(11.0)
        .setCodeBlockCopyTextFontStyle(FontStyle.Normal)
        .setCodeBlockCopyTextFontWeight(FontWeight.W600)
//        .setCodeBlockCopyTextFontFamily("Hei")
        .setCodeBlockCopyTextLineHeight(16.0)
        .setCodeBlockFullScreenButtonIsShow(false)
        .setCodeBlockFullScreenTextIsShow(false)
        .setCodeBlockFullScreenIconWidth(30.0)
        .setCodeBlockFullScreenIconHeight(30.0)
        .setCodeBlockFullScreenIconTextSpacing(8.0)
        .setCodeBlockFullScreenText("FULL")
        .setCodeBlockFullScreenTextFontColor(Color.WHITE)
        .setCodeBlockFullScreenTextFontSize(11.0)
        .setCodeBlockFullScreenTextFontStyle(FontStyle.Normal)
        .setCodeBlockFullScreenTextFontWeight(FontWeight.W600)
//        .setCodeBlockFullScreenTextFontFamily("Hei")
        .setCodeBlockFullScreenTextLineHeight(16.0)
        .setCodeBlockLineNumberIsShow(false)
        .setCodeBlockLineNumberTextPaddingLeft(12.0)

        .setCodeBlockLineNumberTextFontColor(Color.GREY)
        .setCodeBlockLineNumberTextFontSize(11.0)
        .setCodeBlockLineNumberTextFontStyle(FontStyle.Normal)
        .setCodeBlockLineNumberTextFontWeight(FontWeight.W300)
//        .setCodeBlockLineNumberTextFontFamily("Hei")
        .setCodeBlockLineNumberTextLineHeight(18.0)
        .setCodeBlockDividerColor(Color.GREY)
        .setCodeBlockDividerStrokeWidth(1.0)
        .setCodeBlockLineNumberDividerSpacing(12.0)
        .setCodeBlockTextMarginRight(12.0)
        .setCodeBlockTextMarginLeft(12.0)
        .setCodeBlockTextFontColor(Color.GREY)

        .setCodeBlockTextFontSize(15.0)
        .setCodeBlockTextFontStyle(FontStyle.Normal)
        .setCodeBlockTextFontWeight(FontWeight.W300)
//        .setCodeBlockTextFontFamily("Hei")
        .setCodeBlockTextLineHeight(26.0)
        .setCodeBlockTextLetterSpacing(1.0)
        .setCodeBlockListTitleTextSize(15.0)
        .setCodeBlockListTitleSelectTextSize(15.0)
        .setCodeBlockListTitleSelectTextColor(Color.GREEN)
        .setCodeBlockListTitleUnselectTextColor(Color.GREY)
        .setCodeBlockListTitleSelectBackgroundColor(Color.BLACK)
        .setCodeBlockListTitleUnselectBackgroundColor(Color.BLACK)
//        .setCodeBlockIsSeparate(true) // 其他模块全部不显示
        .setCodeBlockSeparateWidth(60.0)
        .setCodeBlockSeparateIsBottom(true)
    theme.setCodeBlockTheme(codeBlockTheme)

    let audioTheme = AudioTheme()
    audioTheme
        .setAudioBackgroundColor(Color.WHITE)
        .setAudioMargin(14.0)
        .setAudioPadding(16.0)
        .setAudioBorderStyle(BorderStyle.Dashed)
        .setAudioBorderWidth(2.0)
        .setAudioBorderColor(Color.BLUE)
        .setAudioBorderRadius(16.0)
        .setAudioShadowRadius(16.0)
        .setAudioShadowColor(Color.BLUE)
        .setAudioShadowOffsetX(4.0)
        .setAudioShadowOffsetY(6.0)
        .setAudioIconWidth(50.0)
        .setAudioIconHeight(50.0)
        .setAudioIconRadius(10.0)
        .setAudioIconFitType(ImageFit.Fill)
        .setAudioTitleToTypeSpacing(4.0)
        .setAudioTitleTextFontColor(Color.BLUE)
        .setAudioTitleTextFontSize(18.0)
        .setAudioTitleTextFontStyle(FontStyle.Italic)
        .setAudioTitleTextFontWeight(FontWeight.W800)
//        .setAudioTitleTextFontFamily("Hei")
        .setAudioTitleTextLineHeight(24.0)
        .setAudioTypeTextFontColor(Color.GREY)
        .setAudioTypeTextFontSize(13.0)
        .setAudioTypeTextFontStyle(FontStyle.Italic)
        .setAudioTypeTextFontWeight(FontWeight.W500)
//        .setAudioTypeTextFontFamily("Hei")
        .setAudioTypeTextLineHeight(18.0)
        .setAudioButtonBackgroundColor(Color.BLUE)
        .setAudioButtonWidth(100.0)
        .setAudioButtonHeight(40.0)
        .setAudioButtonBorderStyle(BorderStyle.Solid)
        .setAudioButtonBorderWidth(1.0)
        .setAudioButtonBorderColor(Color.BLUE)
        .setAudioButtonRadius(20.0)
        .setAudioButtonText("Play")
        .setAudioButtonTextFontColor(Color.WHITE)
        .setAudioButtonTextFontSize(16.0)
        .setAudioButtonTextFontStyle(FontStyle.Normal)
        .setAudioButtonTextFontWeight(FontWeight.W700)
//        .setAudioButtonTextFontFamily("Hei")
        .setAudioButtonTextLineHeight(24.0)
    theme.setAudioTheme(audioTheme)

    let videoTheme = VideoTheme()
    videoTheme.setVideoBackgroundColor(Color.BLACK)
        .setVideoMargin(14.0)
        .setVideoPadding(8.0)
        .setVideoBorderRadius(14.0)
        .setVideoBorderStyle(BorderStyle.Dashed)
        .setVideoBorderWidth(2.0)
        .setVideoBorderColor(Color.GREY)
        .setVideoImageFitType(ImageFit.Fill)
        .setVideoPlayIconWidth(70.0)
        .setVideoPlayIconHeight(70.0)
        .setVideoPlayIconFitType(ImageFit.Fill)
        .setVideoTimeTextFontColor(Color.YELLOW)
        .setVideoTimeTextFontSize(16.0)
        .setVideoTimeTextFontStyle(FontStyle.Italic)
        .setVideoTimeTextFontWeight(FontWeight.W700)
//        .setVideoTimeTextFontFamily("Hei")
        .setVideoTimeTextLineHeight(24.0)
        .setVideoTimeTextMarginRight(14.0)
        .setVideoTimeTextMarginBottom(14.0)
        .setVideoBottomLayoutVisible(true)
        .setVideoBottomLayoutMarginTop(20.0)
        .setVideoReleaseButtonVisible(false)
        .setVideoReleaseButtonBackgroundColor(Color.BLUE)
        .setVideoReleaseButtonWidth(160.0)
        .setVideoReleaseButtonHeight(50.0)
        .setVideoReleaseButtonRadius(25.0)
        .setVideoReleaseButtonIconTextGap(8.0)
        .setVideoReleaseButtonIconWidth(22.0)
        .setVideoReleaseButtonIconHeight(22.0)
        .setVideoReleaseButtonText("Publish")
        .setVideoReleaseButtonTextFontColor(Color.WHITE)
        .setVideoReleaseButtonTextFontSize(18.0)
        .setVideoReleaseButtonTextFontStyle(FontStyle.Italic)
        .setVideoReleaseButtonTextFontWeight(FontWeight.W700)
//        .setVideoReleaseButtonTextFontFamily("Hei")
        .setVideoReleaseButtonTextLineHeight(26.0)
        .setVideoDownloadButtonVisible(false)
        .setVideoDownloadButtonBackgroundColor(Color.GREEN)
        .setVideoDownloadButtonWidth(160.0)
        .setVideoDownloadButtonHeight(50.0)
        .setVideoDownloadButtonRadius(25.0)
        .setVideoDownloadButtonIconTextGap(8.0)
        .setVideoDownloadButtonIconWidth(22.0)
        .setVideoDownloadButtonIconHeight(22.0)
        .setVideoDownloadButtonText("Download")
        .setVideoDownloadButtonTextFontColor(Color.WHITE)
        .setVideoDownloadButtonTextFontSize(18.0)
        .setVideoDownloadButtonTextFontStyle(FontStyle.Italic)
        .setVideoDownloadButtonTextFontWeight(FontWeight.W700)
//        .setVideoDownloadButtonTextFontFamily("Hei")
        .setVideoDownloadButtonTextLineHeight(26.0)
    theme.setVideoTheme(videoTheme)

    let bannerTheme = BannerTheme()
    bannerTheme.setBannerMargin(10.0)
        .setBannerPadding(8.0)
    theme.setBannerTheme(bannerTheme)

    let footnoteDefTheme = FootnoteDefTheme()
    footnoteDefTheme.setFootnoteDefBackgroundColor(Color.YELLOW)
        .setFootnoteDefMargin(6.0)
        .setFootnoteDefPadding(4.0)
    theme.setFootnoteDefTheme(footnoteDefTheme)

    let footnoteRefTheme = FootnoteRefTheme()
    footnoteRefTheme.setFootnoteRefTextFontColor(Color.GREEN)
        .setFootnoteRefTextFontSize(12.0)
        .setFootnoteRefTextFontStyle(FontStyle.Italic)
        .setFootnoteRefTextFontWeight(FontWeight.W700)
//        .setFootnoteRefTextFontFamily("Hei")
        .setFootnoteRefTextLineHeight(18.0)
        .setFootnoteRefTextLetterSpacing(1.0)
        .setFootnoteRefTextDecorationType(TextDecorationType.None)
        .setFootnoteRefTextDecorationColor(Color.GREEN)
        .setFootnoteRefTextDecorationStyle(MarkdownTextDecorationStyle.DASHED)
        .setFootnoteRefTextBackgroundColor(Color.YELLOW)
        .setFootnoteRefTextBackgroundRadius(3.0)
    theme.setFootnoteRefTheme(footnoteRefTheme)

    let inlineCodeTheme = InlineCodeTheme()
    inlineCodeTheme.setInlineCodeTextFontColor(Color.RED)
        .setInlineCodeTextFontSize(15.0)
        .setInlineCodeTextFontStyle(FontStyle.Italic)
        .setInlineCodeTextFontWeight(FontWeight.W600)
//        .setInlineCodeTextFontFamily("Hei")
        .setInlineCodeTextLineHeight(24.0)
        .setInlineCodeTextLetterSpacing(1.0)
        .setInlineCodeTextBackgroundColor(Color.PINK)
        .setInlineCodeTextBackgroundRadius(4.0)
    theme.setInlineCodeTheme(inlineCodeTheme)

    let boldTheme = BoldTheme()
    boldTheme.setBoldTextFontColor(Color.RED)
        .setBoldTextFontSize(16.0)
        .setBoldTextFontStyle(FontStyle.Italic)
        .setBoldTextFontWeight(FontWeight.W900)
//        .setBoldTextFontFamily("Hei")
        .setBoldTextLineHeight(28.0)
        .setBoldTextLetterSpacing(2.0)
    theme.setBoldTheme(boldTheme)

    let latexMathTheme = LatexMathTheme()
    latexMathTheme.setLatexMathMargin(8.0)
        .setLatexMathPadding(4.0)
        .setLatexMathDefaultText(false)
        .setLatexMathDefaultTextFontColor(Color.BLUE)
        .setLatexMathDefaultTextFontSize(20.0)
        .setLatexMathDefaultTextFontStyle(FontStyle.Italic)
        .setLatexMathDefaultTextFontWeight(FontWeight.W700)
//        .setLatexMathDefaultTextFontFamily("Hei")
        .setLatexMathTextSize(20.0)
        .setLatexMathBackgroundColor(Color.BLUE)
        .setLatexMathTextColor(Color.BLUE)
        .setLatexMathBlockCenter(true)
        .setLatexMathResPath("/custom/path/res")
    theme.setLatexMathTheme(latexMathTheme)

    let htmlUnderlineTheme = HtmlUnderlineTheme()
    htmlUnderlineTheme.setHtmlUnderlineTextFontColor(Color.PINK)
        .setHtmlUnderlineTextFontSize(15.0)
        .setHtmlUnderlineTextFontStyle(FontStyle.Italic)
        .setHtmlUnderlineTextFontWeight(FontWeight.W600)
//        .setHtmlUnderlineTextFontFamily("Hei")
        .setHtmlUnderlineTextLineHeight(24.0)
        .setHtmlUnderlineTextLetterSpacing(1.0)
        .setHtmlUnderlineTextDecorationColor(Color.PINK)
        .setHtmlUnderlineTextDecorationStyle(MarkdownTextDecorationStyle.WAVY)
    theme.setHtmlUnderlineTheme(htmlUnderlineTheme)

    // 图片主题对齐 ArkUI 基线（CJMarkdownWrap）：
    // 不设置外边距（默认0）、无宽高钳制、无固定比例、无下载按钮，
    // 仅设置 MaximumWidth=1 与 Cover 缩放
    let imageTheme = ImageTheme()
    imageTheme.setImageMaximumWidth(1.0)
        .setImageFitType(ImageFit.Cover)
    theme.setImageTheme(imageTheme)

    let italicTheme = ItalicTheme()
    italicTheme.setItalicTextFontColor(Color.GREEN)
        .setItalicTextFontSize(15.0)
        .setItalicTextFontWeight(FontWeight.W700)
//        .setItalicTextFontFamily("Hei")
        .setItalicTextLineHeight(26.0)
        .setItalicTextLetterSpacing(1.5)
    theme.setItalicTheme(italicTheme)

    let linkTheme = LinkTheme()
    linkTheme.setLinkIsIcon(false)
        .setLinkListIsIcon(false)
        .setLinkTextFontColor(Color.BLUE)
        .setLinkTextFontSize(16.0)
        .setLinkTextFontStyle(FontStyle.Italic)
        .setLinkTextFontWeight(FontWeight.W600)
//        .setLinkTextFontFamily("Hei")
        .setLinkTextLineHeight(24.0)
        .setLinkTextLetterSpacing(1.0)
        .setLinkTextDecorationType(TextDecorationType.Overline)
        .setLinkTextDecorationColor(Color.BLUE)
        .setLinkTextDecorationStyle(MarkdownTextDecorationStyle.DOTTED)
        .setLinkTextBackgroundColor(Color.YELLOW)
        .setLinkTextBackgroundRadius(4.0)
        .setLinkCircleIconBackgroundColor(Color.PINK)
        .setLinkCircleIconButtonBackgroundColor(Color.BLUE)
        .setLinkCircleIconTextSize(16.0)
        .setLinkCircleIconTextColor(Color.WHITE)
        .setLinkCircleIconRadius(24.0)
        .setLinkCircleIconMargin(8.0)
        .setLinkRectIconBackgroundColor(Color.GREEN)
        .setLinkRectIconButtonBackgroundColor(Color.GREEN)
        .setLinkRectIconTextSize(16.0)
        .setLinkRectIconTextColor(Color.WHITE)
        .setLinkRectIconHeight(24.0)
        .setLinkRectIconPadding(8.0)
        .setLinkRectIconRadius(8.0)
        .setLinkRectIconMargin(8.0)
        .setLinkRectToolIconBackgroundColor(Color.YELLOW)
        .setLinkRectToolIconButtonBackgroundColor(Color.YELLOW)
        .setLinkRectToolIconTextSize(16.0)
        .setLinkRectToolIconHeight(25.0)
        .setLinkRectToolIconPadding(8.0)
        .setLinkRectToolIconBorderWidth(2.0)
        .setLinkRectToolIconDividingLineWidth(2.0)
        .setLinkRectToolIconMargin(8.0)
        .setLinkRectToolIconLineLeftPadding(5.0)
        .setLinkRectToolIconLineRightPadding(5.0)
    theme.setLinkTheme(linkTheme)

    let strikethroughTheme = StrikethroughTheme()
    strikethroughTheme.setStrikethroughTextFontColor(Color.PINK)
        .setStrikethroughTextFontSize(15.0)
        .setStrikethroughTextFontStyle(FontStyle.Italic)
        .setStrikethroughTextFontWeight(FontWeight.W600)
//        .setStrikethroughTextFontFamily("Hei")
        .setStrikethroughTextLineHeight(24.0)
        .setStrikethroughTextLetterSpacing(1.0)
        .setStrikethroughTextDecorationColor(Color.PINK)
        .setStrikethroughTextDecorationStyle(MarkdownTextDecorationStyle.WAVY)
    theme.setStrikethroughTheme(strikethroughTheme)

    let highlightTheme = HighlightTheme()
    highlightTheme.setHighlightTextFontColor(Color.BROWN)
        .setHighlightTextFontSize(15.0)
        .setHighlightTextFontStyle(FontStyle.Italic)
        .setHighlightTextFontWeight(FontWeight.W700)
//        .setHighlightTextFontFamily("Hei")
        .setHighlightTextLineHeight(26.0)
        .setHighlightTextLetterSpacing(1.0)
        .setHighlightTextBackgroundColor(Color.YELLOW)
        .setHighlightTextBackgroundRadius(4.0)
    theme.setHighlightTheme(highlightTheme)

    let subTheme = SubTheme()
    subTheme.setSubTextFontColor(Color.RED)
        .setSubTextFontSize(10.0)
        .setSubTextFontStyle(FontStyle.Italic)
        .setSubTextFontWeight(FontWeight.W600)
//        .setSubTextFontFamily("Hei")
        .setSubTextLetterSpacing(0.5)
        .setSubTextBaselineOffset(-3.0)
    theme.setSubTheme(subTheme)

    let supTheme = SupTheme()
    supTheme.setSupTextFontColor(Color.BLUE)
        .setSupTextFontSize(10.0)
        .setSupTextFontStyle(FontStyle.Italic)
        .setSupTextFontWeight(FontWeight.W600)
//        .setSupTextFontFamily("Hei")
        .setSupTextLetterSpacing(0.5)
        .setSupTextBaselineOffset(10.0)
    theme.setSupTheme(supTheme)
    return theme
}



public func setParamsThemeAll(theme: MarkdownTheme): MarkdownTheme {
    let globalTheme = GlobalTheme()
    globalTheme.setIsMarkdownParserSync(true)
        .setEnableParseThrottle(true)
        .setParseThrottleMs(500)
        .setIsOnCopy(false)
        .setGlobalMargin(16.0)
        .setBlockSpacing(20)
        .setIsLineBreak(true)
        .setOpenGestureSwipe(true)
        .setBackgroundColor(Color.GREY)
        .setParagraphHeadingAnimationEnabled(true)
        .setParagraphHeadingAnimationDuration(600)
    theme.setGlobalTheme(globalTheme)

    let paragraphTheme = ParagraphTheme()
    paragraphTheme.setParagraphBackgroundColor(Color.GREY)
        .setParagraphMargin(12.0)
        .setParagraphPadding(6.0)
        .setParagraphTextFontColor(Color.BLACK)
        .setParagraphTextFontSize(18.0)
        .setParagraphTextFontStyle(FontStyle.Italic)
        .setParagraphTextFontWeight(FontWeight.W700)
        .setParagraphTextFontFamily("Hei")
        .setParagraphTextLineHeight(30.0)
        .setParagraphTextLetterSpacing(2.0)
        .setParagraphBeforeSelectedBackgroundColor(Color.BLUE)
        .setParagraphSelectedBackgroundColor(Color.BLUE)
    theme.setParagraphTheme(paragraphTheme)

    let headingTheme = HeadingTheme()
    headingTheme.setBackgroundColorForAllHeading(Color.YELLOW)
        .setMarginForAllHeadingEachLevel(10.0)
        .setPaddingForAllHeadingEachLevel(5.0)
        .setTextFontColorForAllHeading(Color.BLUE)
        .setTextFontSizeForAllHeading(24.0)
        .setTextFontStyleForAllHeading(FontStyle.Italic)
        .setTextFontWeightForAllHeading(FontWeight.W800)
        .setTextFontFamilyForAllHeading("Hei")
        .setTextLineHeightForAllHeading(36.0)
        .setTextLetterSpacingForAllHeading(3.0)
        .setUnderlineHeightForAllHeading(2.0)
        .setUnderlineColorForAllHeading(Color.BLUE)
        .setUnderlineSpacingForAllHeading(4.0)
    theme.setHeadingTheme(headingTheme)

    let tableTheme = TableTheme()
    tableTheme.setTableTitleBackgroundColor(Color.BLUE)
        .setTableContentOddRowBackgroundColor(Color.GREEN)
        .setTableContentEvenRowBackgroundColor(Color.YELLOW)
        .setTableMargin(8.0)
        .setTablePadding(4.0)
        .setTableCellPadding(8.0)
        .setTableBorderStyle(BorderStyle.Dashed)
        .setTableBorderWidth(2.0)
        .setTableBorderColor(Color.GREEN)
        .setTableRadius(10.0)
        .setTableScrollBarState(BarState.On)
        .setTableScrollBarColor(Color.RED)
        .setTableMinCellWidth(80.0)
        .setTableMaxCellWidth(400.0)
        .setTableFirstColumnIsBold(true)
        .setTableTitleTextFontColor(Color.BLUE)
        .setTableTitleTextFontSize(16.0)
        .setTableTitleTextFontStyle(FontStyle.Italic)
        .setTableTitleTextFontWeight(FontWeight.W700)
        .setTableTitleTextFontFamily("Hei")
        .setTableTitleTextLineHeight(28.0)
        .setTableTitleTextLetterSpacing(1.5)
        .setTableContentTextFontColor(Color.GREEN)
        .setTableContentTextFontSize(15.0)
        .setTableContentTextFontStyle(FontStyle.Italic)
        .setTableContentTextFontWeight(FontWeight.W500)
        .setTableContentTextFontFamily("Hei")
        .setTableContentTextLineHeight(26.0)
        .setTableContentTextLetterSpacing(1.0)
        .setTableStickyHeader(true)
        .setTableHeadIsShow(true)
        .setTableHeadTitleText("Table Header")
        .setTableHeadTitleTextMarginLeft(6.0)
    theme.setTableTheme(tableTheme)

    let dividerTheme = DividerTheme()
    dividerTheme.setDividerMargin(10.0)
        .setDividerPadding(5.0)
        .setDividerColor(Color.RED)
        .setDividerStrokeWidth(3.0)
        .setDividerStyle(LineCapStyle.Round)
    theme.setDividerTheme(dividerTheme)

    let blockQuoteTheme = BlockQuoteTheme()
    blockQuoteTheme.setBlockQuoteBackgroundColor(Color.BLUE)
        .setBlockQuoteMargin(12.0)
        .setBlockQuotePadding(10.0)
        .setBlockQuoteRadius(6.0)
        .setBlockQuoteLeftBorderWidth(4.0)
        .setBlockQuoteLeftBorderColor(Color.BLUE)
        .setBlockQuoteChildSpacing(4)
    theme.setBlockQuoteTheme(blockQuoteTheme)

    let orderedListTheme = OrderedListTheme()
    orderedListTheme.setOrderedListBackgroundColor(Color.YELLOW)
        .setOrderedListMargin(10.0)
        .setOrderedListPadding(6.0)
        .setOrderedListChildSpacing(4)
        .setOrderedListChildChildSpacing(2)
        .setOrderedListMarkerSpacing(12.0)
        .setOrderedListMarkerTextFontColor(Color.PINK)
        .setOrderedListMarkerTextFontSize(16.0)
        .setOrderedListMarkerTextFontStyle(FontStyle.Italic)
        .setOrderedListMarkerTextFontWeight(FontWeight.W700)
        .setOrderedListMarkerTextFontFamily("Hei")
        .setOrderedListMarkerTextLineHeight(26.0)
    theme.setOrderedListTheme(orderedListTheme)

    let bulletListTheme = BulletListTheme()
    bulletListTheme.setBulletListBackgroundColor(Color.PINK)
        .setBulletListMargin(10.0)
        .setBulletListPadding(6.0)
        .setBulletListChildSpacing(4)
        .setBulletListChildChildSpacing(2)
        .setBulletListBulletSpacing(12.0)
        .setBulletListBulletIsCircle(true)
        .setBulletListBulletTextFontColor(Color.RED)
        .setBulletListBulletTextFontSize(6.0)
        .setBulletListBulletTextFontStyle(FontStyle.Italic)
        .setBulletListBulletTextFontWeight(FontWeight.W700)
        .setBulletListBulletTextFontFamily("Hei")
        .setBulletListBulletTextLineHeight(22.0)
        .setBulletListCheckboxSpacing(10.0)
        .setBulletListCheckboxWidth(20.0)
        .setBulletListCheckboxHeight(20.0)
        .setBulletListCheckboxSelectedColor(Color.BLUE)
        .setBulletListCheckboxShape(CheckBoxShape.CIRCLE)
    theme.setBulletListTheme(bulletListTheme)

    let definitionListTheme = DefinitionListTheme()
    definitionListTheme.setDefinitionListBackgroundColor(Color.YELLOW)
        .setDefinitionListMargin(8.0)
        .setDefinitionListPadding(4.0)
        .setDefinitionListTermToDescriptionSpacing(12.0)
        .setDefinitionListTermTextFontWeight(FontWeight.W800)
        .setDefinitionListTermTextFontStyle(FontStyle.Normal)
        .setDefinitionListDescriptionItemSpacing(12.0)
        .setDefinitionListDescriptionIndent(16.0)
    theme.setDefinitionListTheme(definitionListTheme)

    let codeBlockTheme = CodeBlockTheme()
    codeBlockTheme.setCodeBlockIsCodeFormat(true)
        .setCodeBlockIsDark(true)
        .setCodeBlockUseTab(true)
        .setCodeBlockIndentWidth(2)
        .setCodeBlockParserSync(true)
        .setCodeBlockBackgroundColor(Color.BLACK)
        .setCodeBlockMargin(6.0)
        .setCodeBlockPadding(10.0)
        .setCodeBlockBorderStyle(BorderStyle.Dotted)
        .setCodeBlockBorderWidth(1.0)
        .setCodeBlockBorderColor(Color.BLACK)
        .setCodeBlockRadius(12.0)
        .setCodeBlockTitleLayoutMarginBottom(4.0)
        .setCodeBlockTypeTextMarginLeft(12.0)
        .setCodeBlockTypeText("custom")
        .setCodeBlockTypeTextFontColor(Color.RED)
        .setCodeBlockTypeTextFontSize(12.0)
        .setCodeBlockTypeTextFontStyle(FontStyle.Italic)
        .setCodeBlockTypeTextFontWeight(FontWeight.W600)
        .setCodeBlockTypeTextFontFamily("Hei")
        .setCodeBlockTypeTextLineHeight(18.0)
        .setCodeBlockCopyFullScreenSpacing(8.0)
        .setCodeBlockCopyButtonIsShow(false)
        .setCodeBlockCopyTextIsShow(false)
        .setCodeBlockCopyIconWidth(30.0)
        .setCodeBlockCopyIconHeight(30.0)
        .setCodeBlockCopyIconTextSpacing(8.0)
        .setCodeBlockCopyText("COPY")
        .setCodeBlockCopyTextFontColor(Color.WHITE)
        .setCodeBlockCopyTextFontSize(11.0)
        .setCodeBlockCopyTextFontStyle(FontStyle.Normal)
        .setCodeBlockCopyTextFontWeight(FontWeight.W600)
        .setCodeBlockCopyTextFontFamily("Hei")
        .setCodeBlockCopyTextLineHeight(16.0)
        .setCodeBlockFullScreenButtonIsShow(false)
        .setCodeBlockFullScreenTextIsShow(false)
        .setCodeBlockFullScreenIconWidth(30.0)
        .setCodeBlockFullScreenIconHeight(30.0)
        .setCodeBlockFullScreenIconTextSpacing(8.0)
        .setCodeBlockFullScreenText("FULL")
        .setCodeBlockFullScreenTextFontColor(Color.WHITE)
        .setCodeBlockFullScreenTextFontSize(11.0)
        .setCodeBlockFullScreenTextFontStyle(FontStyle.Normal)
        .setCodeBlockFullScreenTextFontWeight(FontWeight.W600)
        .setCodeBlockFullScreenTextFontFamily("Hei")
        .setCodeBlockFullScreenTextLineHeight(16.0)
        .setCodeBlockLineNumberIsShow(false)
        .setCodeBlockLineNumberTextPaddingLeft(12.0)

        .setCodeBlockLineNumberTextFontColor(Color.GREY)
        .setCodeBlockLineNumberTextFontSize(11.0)
        .setCodeBlockLineNumberTextFontStyle(FontStyle.Normal)
        .setCodeBlockLineNumberTextFontWeight(FontWeight.W300)
        .setCodeBlockLineNumberTextFontFamily("Hei")
        .setCodeBlockLineNumberTextLineHeight(18.0)
        .setCodeBlockDividerColor(Color.GREY)
        .setCodeBlockDividerStrokeWidth(1.0)
        .setCodeBlockLineNumberDividerSpacing(12.0)
        .setCodeBlockTextMarginRight(12.0)
        .setCodeBlockTextMarginLeft(12.0)
        .setCodeBlockTextFontColor(Color.GREY)

        .setCodeBlockTextFontSize(15.0)
        .setCodeBlockTextFontStyle(FontStyle.Normal)
        .setCodeBlockTextFontWeight(FontWeight.W300)
        .setCodeBlockTextFontFamily("Hei")
        .setCodeBlockTextLineHeight(26.0)
        .setCodeBlockTextLetterSpacing(1.0)
        .setCodeBlockListTitleTextSize(15.0)
        .setCodeBlockListTitleSelectTextSize(15.0)
        .setCodeBlockListTitleSelectTextColor(Color.GREEN)
        .setCodeBlockListTitleUnselectTextColor(Color.GREY)
        .setCodeBlockListTitleSelectBackgroundColor(Color.BLACK)
        .setCodeBlockListTitleUnselectBackgroundColor(Color.BLACK)
//        .setCodeBlockIsSeparate(true) // 其他模块全部不显示
        .setCodeBlockSeparateWidth(60.0)
        .setCodeBlockSeparateIsBottom(true)
    theme.setCodeBlockTheme(codeBlockTheme)

    let audioTheme = AudioTheme()
    audioTheme
        .setAudioBackgroundColor(Color.WHITE)
        .setAudioMargin(14.0)
        .setAudioPadding(16.0)
        .setAudioBorderStyle(BorderStyle.Dashed)
        .setAudioBorderWidth(2.0)
        .setAudioBorderColor(Color.BLUE)
        .setAudioBorderRadius(16.0)
        .setAudioShadowRadius(16.0)
        .setAudioShadowColor(Color.BLUE)
        .setAudioShadowOffsetX(4.0)
        .setAudioShadowOffsetY(6.0)
        .setAudioIconWidth(50.0)
        .setAudioIconHeight(50.0)
        .setAudioIconRadius(10.0)
        .setAudioIconFitType(ImageFit.Fill)
        .setAudioTitleToTypeSpacing(4.0)
        .setAudioTitleTextFontColor(Color.BLUE)
        .setAudioTitleTextFontSize(18.0)
        .setAudioTitleTextFontStyle(FontStyle.Italic)
        .setAudioTitleTextFontWeight(FontWeight.W800)
        .setAudioTitleTextFontFamily("Hei")
        .setAudioTitleTextLineHeight(24.0)
        .setAudioTypeTextFontColor(Color.GREY)
        .setAudioTypeTextFontSize(13.0)
        .setAudioTypeTextFontStyle(FontStyle.Italic)
        .setAudioTypeTextFontWeight(FontWeight.W500)
        .setAudioTypeTextFontFamily("Hei")
        .setAudioTypeTextLineHeight(18.0)
        .setAudioButtonBackgroundColor(Color.BLUE)
        .setAudioButtonWidth(100.0)
        .setAudioButtonHeight(40.0)
        .setAudioButtonBorderStyle(BorderStyle.Solid)
        .setAudioButtonBorderWidth(1.0)
        .setAudioButtonBorderColor(Color.BLUE)
        .setAudioButtonRadius(20.0)
        .setAudioButtonText("Play")
        .setAudioButtonTextFontColor(Color.WHITE)
        .setAudioButtonTextFontSize(16.0)
        .setAudioButtonTextFontStyle(FontStyle.Normal)
        .setAudioButtonTextFontWeight(FontWeight.W700)
        .setAudioButtonTextFontFamily("Hei")
        .setAudioButtonTextLineHeight(24.0)
    theme.setAudioTheme(audioTheme)

    let videoTheme = VideoTheme()
    videoTheme.setVideoBackgroundColor(Color.BLACK)
        .setVideoMargin(14.0)
        .setVideoPadding(8.0)
        .setVideoBorderRadius(14.0)
        .setVideoBorderStyle(BorderStyle.Dashed)
        .setVideoBorderWidth(2.0)
        .setVideoBorderColor(Color.GREY)
        .setVideoImageFitType(ImageFit.Fill)
        .setVideoPlayIconWidth(70.0)
        .setVideoPlayIconHeight(70.0)
        .setVideoPlayIconFitType(ImageFit.Fill)
        .setVideoTimeTextFontColor(Color.YELLOW)
        .setVideoTimeTextFontSize(16.0)
        .setVideoTimeTextFontStyle(FontStyle.Italic)
        .setVideoTimeTextFontWeight(FontWeight.W700)
        .setVideoTimeTextFontFamily("Hei")
        .setVideoTimeTextLineHeight(24.0)
        .setVideoTimeTextMarginRight(14.0)
        .setVideoTimeTextMarginBottom(14.0)
        .setVideoBottomLayoutVisible(true)
        .setVideoBottomLayoutMarginTop(20.0)
        .setVideoReleaseButtonVisible(false)
        .setVideoReleaseButtonBackgroundColor(Color.BLUE)
        .setVideoReleaseButtonWidth(160.0)
        .setVideoReleaseButtonHeight(50.0)
        .setVideoReleaseButtonRadius(25.0)
        .setVideoReleaseButtonIconTextGap(8.0)
        .setVideoReleaseButtonIconWidth(22.0)
        .setVideoReleaseButtonIconHeight(22.0)
        .setVideoReleaseButtonText("Publish")
        .setVideoReleaseButtonTextFontColor(Color.WHITE)
        .setVideoReleaseButtonTextFontSize(18.0)
        .setVideoReleaseButtonTextFontStyle(FontStyle.Italic)
        .setVideoReleaseButtonTextFontWeight(FontWeight.W700)
        .setVideoReleaseButtonTextFontFamily("Hei")
        .setVideoReleaseButtonTextLineHeight(26.0)
        .setVideoDownloadButtonVisible(false)
        .setVideoDownloadButtonBackgroundColor(Color.GREEN)
        .setVideoDownloadButtonWidth(160.0)
        .setVideoDownloadButtonHeight(50.0)
        .setVideoDownloadButtonRadius(25.0)
        .setVideoDownloadButtonIconTextGap(8.0)
        .setVideoDownloadButtonIconWidth(22.0)
        .setVideoDownloadButtonIconHeight(22.0)
        .setVideoDownloadButtonText("Download")
        .setVideoDownloadButtonTextFontColor(Color.WHITE)
        .setVideoDownloadButtonTextFontSize(18.0)
        .setVideoDownloadButtonTextFontStyle(FontStyle.Italic)
        .setVideoDownloadButtonTextFontWeight(FontWeight.W700)
        .setVideoDownloadButtonTextFontFamily("Hei")
        .setVideoDownloadButtonTextLineHeight(26.0)
    theme.setVideoTheme(videoTheme)

    let bannerTheme = BannerTheme()
    bannerTheme.setBannerMargin(10.0)
        .setBannerPadding(8.0)
    theme.setBannerTheme(bannerTheme)

    let footnoteDefTheme = FootnoteDefTheme()
    footnoteDefTheme.setFootnoteDefBackgroundColor(Color.YELLOW)
        .setFootnoteDefMargin(6.0)
        .setFootnoteDefPadding(4.0)
    theme.setFootnoteDefTheme(footnoteDefTheme)

    let footnoteRefTheme = FootnoteRefTheme()
    footnoteRefTheme.setFootnoteRefTextFontColor(Color.GREEN)
        .setFootnoteRefTextFontSize(12.0)
        .setFootnoteRefTextFontStyle(FontStyle.Italic)
        .setFootnoteRefTextFontWeight(FontWeight.W700)
        .setFootnoteRefTextFontFamily("Hei")
        .setFootnoteRefTextLineHeight(18.0)
        .setFootnoteRefTextLetterSpacing(1.0)
        .setFootnoteRefTextDecorationType(TextDecorationType.None)
        .setFootnoteRefTextDecorationColor(Color.GREEN)
        .setFootnoteRefTextDecorationStyle(MarkdownTextDecorationStyle.DASHED)
        .setFootnoteRefTextBackgroundColor(Color.YELLOW)
        .setFootnoteRefTextBackgroundRadius(3.0)
    theme.setFootnoteRefTheme(footnoteRefTheme)

    let inlineCodeTheme = InlineCodeTheme()
    inlineCodeTheme.setInlineCodeTextFontColor(Color.RED)
        .setInlineCodeTextFontSize(15.0)
        .setInlineCodeTextFontStyle(FontStyle.Italic)
        .setInlineCodeTextFontWeight(FontWeight.W600)
        .setInlineCodeTextFontFamily("Hei")
        .setInlineCodeTextLineHeight(24.0)
        .setInlineCodeTextLetterSpacing(1.0)
        .setInlineCodeTextBackgroundColor(Color.PINK)
        .setInlineCodeTextBackgroundRadius(4.0)
    theme.setInlineCodeTheme(inlineCodeTheme)

    let boldTheme = BoldTheme()
    boldTheme.setBoldTextFontColor(Color.RED)
        .setBoldTextFontSize(16.0)
        .setBoldTextFontStyle(FontStyle.Italic)
        .setBoldTextFontWeight(FontWeight.W900)
        .setBoldTextFontFamily("Hei")
        .setBoldTextLineHeight(28.0)
        .setBoldTextLetterSpacing(2.0)
    theme.setBoldTheme(boldTheme)

    let latexMathTheme = LatexMathTheme()
    latexMathTheme.setLatexMathMargin(8.0)
        .setLatexMathPadding(4.0)
        .setLatexMathDefaultText(false)
        .setLatexMathDefaultTextFontColor(Color.BLUE)
        .setLatexMathDefaultTextFontSize(20.0)
        .setLatexMathDefaultTextFontStyle(FontStyle.Italic)
        .setLatexMathDefaultTextFontWeight(FontWeight.W700)
        .setLatexMathDefaultTextFontFamily("Hei")
        .setLatexMathTextSize(20.0)
        .setLatexMathBackgroundColor(Color.BLUE)
        .setLatexMathTextColor(Color.BLUE)
        .setLatexMathBlockCenter(true)
        .setLatexMathResPath("/custom/path/res")
    theme.setLatexMathTheme(latexMathTheme)

    let htmlUnderlineTheme = HtmlUnderlineTheme()
    htmlUnderlineTheme.setHtmlUnderlineTextFontColor(Color.PINK)
        .setHtmlUnderlineTextFontSize(15.0)
        .setHtmlUnderlineTextFontStyle(FontStyle.Italic)
        .setHtmlUnderlineTextFontWeight(FontWeight.W600)
        .setHtmlUnderlineTextFontFamily("Hei")
        .setHtmlUnderlineTextLineHeight(24.0)
        .setHtmlUnderlineTextLetterSpacing(1.0)
        .setHtmlUnderlineTextDecorationColor(Color.PINK)
        .setHtmlUnderlineTextDecorationStyle(MarkdownTextDecorationStyle.WAVY)
    theme.setHtmlUnderlineTheme(htmlUnderlineTheme)

    // 图片主题对齐 ArkUI 基线（CJMarkdownWrap）：
    // 不设置外边距（默认0）、无宽高钳制、无固定比例、无下载按钮，
    // 仅设置 MaximumWidth=1 与 Cover 缩放
    let imageTheme = ImageTheme()
    imageTheme.setImageMaximumWidth(1.0)
        .setImageFitType(ImageFit.Cover)
    theme.setImageTheme(imageTheme)

    let italicTheme = ItalicTheme()
    italicTheme.setItalicTextFontColor(Color.GREEN)
        .setItalicTextFontSize(15.0)
        .setItalicTextFontWeight(FontWeight.W700)
        .setItalicTextFontFamily("Hei")
        .setItalicTextLineHeight(26.0)
        .setItalicTextLetterSpacing(1.5)
    theme.setItalicTheme(italicTheme)

    let linkTheme = LinkTheme()
    linkTheme.setLinkIsIcon(true)
        .setLinkListIsIcon(false)
        .setLinkTextFontColor(Color.BLUE)
        .setLinkTextFontSize(16.0)
        .setLinkTextFontStyle(FontStyle.Italic)
        .setLinkTextFontWeight(FontWeight.W600)
//        .setLinkTextFontFamily("Hei")
        .setLinkTextLineHeight(24.0)
        .setLinkTextLetterSpacing(1.0)
        .setLinkTextDecorationType(TextDecorationType.Overline)
        .setLinkTextDecorationColor(Color.BLUE)
        .setLinkTextDecorationStyle(MarkdownTextDecorationStyle.DOTTED)
        .setLinkTextBackgroundColor(Color.YELLOW)
        .setLinkTextBackgroundRadius(4.0)
        .setLinkCircleIconBackgroundColor(Color.PINK)
        .setLinkCircleIconButtonBackgroundColor(Color.BLUE)
        .setLinkCircleIconTextSize(16.0)
        .setLinkCircleIconTextColor(Color.WHITE)
        .setLinkCircleIconRadius(24.0)
        .setLinkCircleIconMargin(8.0)
        .setLinkRectIconBackgroundColor(Color.GREEN)
        .setLinkRectIconButtonBackgroundColor(Color.GREEN)
        .setLinkRectIconTextSize(16.0)
        .setLinkRectIconTextColor(Color.WHITE)
        .setLinkRectIconHeight(24.0)
        .setLinkRectIconPadding(8.0)
        .setLinkRectIconRadius(8.0)
        .setLinkRectIconMargin(8.0)
        .setLinkRectToolIconBackgroundColor(Color.YELLOW)
        .setLinkRectToolIconButtonBackgroundColor(Color.YELLOW)
        .setLinkRectToolIconTextSize(16.0)
        .setLinkRectToolIconHeight(25.0)
        .setLinkRectToolIconPadding(8.0)
        .setLinkRectToolIconBorderWidth(2.0)
        .setLinkRectToolIconDividingLineWidth(2.0)
        .setLinkRectToolIconMargin(8.0)
        .setLinkRectToolIconLineLeftPadding(5.0)
        .setLinkRectToolIconLineRightPadding(5.0)
    theme.setLinkTheme(linkTheme)

    let strikethroughTheme = StrikethroughTheme()
    strikethroughTheme.setStrikethroughTextFontColor(Color.PINK)
        .setStrikethroughTextFontSize(15.0)
        .setStrikethroughTextFontStyle(FontStyle.Italic)
        .setStrikethroughTextFontWeight(FontWeight.W600)
        .setStrikethroughTextFontFamily("Hei")
        .setStrikethroughTextLineHeight(24.0)
        .setStrikethroughTextLetterSpacing(1.0)
        .setStrikethroughTextDecorationColor(Color.PINK)
        .setStrikethroughTextDecorationStyle(MarkdownTextDecorationStyle.WAVY)
    theme.setStrikethroughTheme(strikethroughTheme)

    let highlightTheme = HighlightTheme()
    highlightTheme.setHighlightTextFontColor(Color.BROWN)
        .setHighlightTextFontSize(15.0)
        .setHighlightTextFontStyle(FontStyle.Italic)
        .setHighlightTextFontWeight(FontWeight.W700)
        .setHighlightTextFontFamily("Hei")
        .setHighlightTextLineHeight(26.0)
        .setHighlightTextLetterSpacing(1.0)
        .setHighlightTextBackgroundColor(Color.YELLOW)
        .setHighlightTextBackgroundRadius(4.0)
    theme.setHighlightTheme(highlightTheme)

    let subTheme = SubTheme()
    subTheme.setSubTextFontColor(Color.RED)
        .setSubTextFontSize(10.0)
        .setSubTextFontStyle(FontStyle.Italic)
        .setSubTextFontWeight(FontWeight.W600)
        .setSubTextFontFamily("Hei")
        .setSubTextLetterSpacing(0.5)
        .setSubTextBaselineOffset(-3.0)
    theme.setSubTheme(subTheme)

    let supTheme = SupTheme()
    supTheme.setSupTextFontColor(Color.BLUE)
        .setSupTextFontSize(10.0)
        .setSupTextFontStyle(FontStyle.Italic)
        .setSupTextFontWeight(FontWeight.W600)
        .setSupTextFontFamily("Hei")
        .setSupTextLetterSpacing(0.5)
        .setSupTextBaselineOffset(10.0)
    theme.setSupTheme(supTheme)
    return theme
}
