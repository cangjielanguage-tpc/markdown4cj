  aboutToAppear(): void {
    this.folderList = getFileListStr(`${this.rawFilePath}/`)
  }

  build() {
    Column() {
      titleComponent(
        "组合代码块配置页面",
        0xFF317AFF,
        true,
        this.safeTop
